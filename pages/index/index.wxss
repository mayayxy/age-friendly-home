.page {
  padding: 24rpx;
}

.hero {
  padding: 32rpx;
  background: linear-gradient(180deg, #eef9f7, #ffffff);
}

.hero-badge {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #d8f1ec;
  color: #2f8f83;
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 20rpx;
  font-size: 42rpx;
  line-height: 1.4;
  font-weight: 700;
  color: #0f172a;
}

.hero-desc {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #475569;
}

.section {
  margin-top: 24rpx;
  padding: 28rpx;
}

.image-preview-wrap {
  margin-top: 24rpx;
}

.image-preview {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
  background: #e5e7eb;
}

.empty-preview {
  margin-top: 24rpx;
  height: 260rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  background: #f8fafc;
}

.empty-icon {
  font-size: 56rpx;
  line-height: 1;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 26rpx;
}

.btn-group {
  margin-top: 24rpx;
}

.scene-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 24rpx;
}

.scene-item {
  width: calc(50% - 9rpx);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 18rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #ffffff;
  font-size: 28rpx;
  color: #334155;
}

.scene-item-active {
  border-color: #6bc7bb;
  background: #f0fbf9;
}

.action-row {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.action-btn {
  flex: 1;
}

.result-card {
  margin-bottom: 36rpx;
}

.result-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.score-tag {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #8a4b00;
  background: #fff2cc;
}

.score-danger {
  color: #9f1239;
  background: #ffe4e6;
}

.score-warn {
  color: #92400e;
  background: #fef3c7;
}

.summary-box {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #f8fafc;
}

.summary-title,
.list-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.summary-text {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #475569;
}

.list-title {
  margin-top: 28rpx;
}

.risk-item {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #fff7ed;
}

.risk-top {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.risk-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #7c2d12;
}

.risk-level {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #b45309;
}

.risk-advice {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #9a3412;
}

.upgrade-item {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  margin-top: 12rpx;
  border-radius: 50%;
  background: #2f8f83;
}

.upgrade-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.7;
  color: #334155;
}
